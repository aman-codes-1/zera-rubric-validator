DEV_HOST=localhost
DEV_PORT=3000
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini

# Local default: .validation-jobs/jobs.sqlite
# VALIDATION_JOB_DB_PATH=/path/to/jobs.sqlite

# Shared storage settings for the web process and worker.
# Required when the processes run on separate hosts.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace_with_your_redis_rest_token
# VALIDATION_JOB_NAMESPACE=zera:validation:v1:production
